# Copy to .env (never commit .env). Values here are built into the site at build time.

# The Ohviana API (ohviana-apis). Locally: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# This site's public URL (canonical links, sitemap, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign-in: 'password' (email + password via the API), 'supabase' (magic link) or 'dev'.
NEXT_PUBLIC_AUTH_MODE=password
# Supabase project URL + publishable key (public, safe in the browser; NOT the secret key).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Browser tests only (npm run e2e) ----
# They clean up the bookings they create directly in the API's database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# OTP_DEV_CODE must also be set on the API (in ohviana-apis/.env) for booking tests.
# OTP_DEV_CODE=123456
